<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Banc d'essai de l'IA hors Unity (dossier ignoré par Unity car hors de Assets/).
    Compile les scripts Model, Core et IA du jeu avec des stubs minimaux de UnityEngine,
    lance des scénarios de vérification puis des parties simulées entre IA.

    Utilisation : se placer dans Tools/AISimulation puis lancer
      dotnet run -c Release [nombre de parties]
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>CampusTycoon.AI.Simulation</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="../../Assets/Scripts/Model/**/*.cs" />
    <Compile Include="../../Assets/Scripts/Core/**/*.cs" />
    <!-- Bus d'événements : tant qu'il est dans View/ (il passera dans Core/, déjà inclus ci-dessus). -->
    <Compile Include="../../Assets/Scripts/View/**/CampusEvents.cs" />
    <Compile Include="../../Assets/Scripts/IA/**/*.cs" Exclude="../../Assets/Scripts/IA/Editor/**" />
  </ItemGroup>

</Project>
